# alena-gateway — deployment environment.
#
#   cp .env.example .env
#
# The origin below names a specific machine, which is why it lives here rather
# than in the tracked registry. There are no secrets. The status service reads nothing privileged and
# holds no credentials: it makes unauthenticated GETs to health endpoints that
# are already unauthenticated by design.

# The origin people reach this gateway on, no trailing slash. `tailscale serve`
# terminates TLS for this name. Required: deploy.sh refuses to run without it,
# and copies it to the server so a reboot restores the same links.
#
#   tailscale status        # to find your MagicDNS name
GATEWAY_ORIGIN=https://alena-server.your-tailnet.ts.net

# Where the status service listens. The container shares the host's network
# namespace, so this is uvicorn's bind address, not a docker port mapping.
# Loopback on purpose — nginx is the only client and it speaks plaintext, so
# 0.0.0.0 would put an unencrypted copy on every network this host is on.
GATEWAY_BIND_ADDRESS=127.0.0.1
GATEWAY_PORT=8090

# How the probes reach the other applications. With host networking this is
# plain loopback, which is the only address any of them binds.
GATEWAY_UPSTREAM_HOST=127.0.0.1

# Tag applied to the built image, and reported on the status page. deploy.sh
# sets this per release so the previous image stays on disk for a rollback.
GATEWAY_IMAGE_TAG=latest

# Where nginx listens for `tailscale serve`. Loopback only: TLS is terminated
# by tailscale, which is the sole thing that connects here.
#
# deploy.sh reads this to point `tailscale serve` at nginx, but the listen
# directive itself lives in nginx/alena-gateway.conf. Change one and you must
# change the other — nginx would go on listening where it always did while
# tailscale started forwarding somewhere nothing answers.
GATEWAY_NGINX_PORT=8088
